# Config for the e2e suite in example/integration_test. Copy to .env.e2e
# (gitignored) and fill in. Passed to the app with --dart-define-from-file.

# Publishable key for the project to test against. A test key (prj_test_pk_…)
# is recommended. Without one, every e2e test is skipped.
RADAR_PUBLISHABLE_KEY=

# API hosts. Leave empty to use the SDK defaults (production). Examples:
#   staging:              https://api.radar-staging.com / https://api-verified.radar-staging.com
#   local, iOS simulator: http://localhost:8081
#   local, Android emu:   http://10.0.2.2:8081
RADAR_HOST=
RADAR_VERIFIED_HOST=

# Set to true only if the project has verified tracking (fraud) enabled.
# trackVerified tests also run only against the production verified host,
# because the bundled fraud SDK can't override its payload encryption key yet.
RADAR_E2E_VERIFIED=false

# Reserved, not used yet: the fraud payload key override for non-production
# hosts, once a fraud SDK that supports it ships.
# RADAR_FRAUD_PUBLIC_KEY=
# RADAR_FRAUD_KEY_VERSION=
